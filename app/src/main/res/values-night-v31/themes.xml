<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Android 12+ always shows a splash screen of its own. It is set to look
      exactly like the first frame of the app's launch screen (LaunchSplash): the
      squares logo, white on black, so the hand-over can't be seen. The icon
      builds the logo as an animation the system runs itself.
    -->
    <style name="Theme.BitChord" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowSplashScreenBackground">@android:color/black</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_logo</item>
        <item name="android:windowSplashScreenAnimationDuration">850</item>
    </style>
</resources>
